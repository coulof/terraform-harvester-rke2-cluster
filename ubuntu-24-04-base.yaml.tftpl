#cloud-config
fqdn: ${hostname}.${domain}
ssh_pwauth: true
package_update: true
packages:
  - qemu-guest-agent
runcmd:
  - systemctl enable --now qemu-guest-agent
  - systemctl stop ufw
  - systemctl disable ufw
users:
  - name: ${ssh_user}
    lock_passwd: false
    hashed_passwd: '$6$ZvdW6Qwo3lEeFZa$32oKhbzwknADiobiUst8zocsMdXI0J1LLE40IdaisE7pCVYNgONrHgh7QHMH2KijSNxodZvmiq5Yi6iP4gcaF1'
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIE71Pf82BiCp98bLPuKhuPdNbVzAMTLqX6lA9hp397+G harvester-cluster-admin'
